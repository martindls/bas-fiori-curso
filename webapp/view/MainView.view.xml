<mvc:View 
    controllerName="martindls.invoices.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true" >

    <Shell id="shell">
        <App id="app">
        <pages>
            <Page id="page" title="{i18n>title}">
                <content>
                   <Panel id="panelID" headerText="{i18n>selectionScreen}" >
                        <Label id="labelShipName" labelFor="shipName" text="{i18n>shipName}" class="sapUiSmallMargin" />
                        <Input id="shipName" value="{selectionScreenMenu>/ShipName}" width="200px" class="sapUiSmallMarginEnd"/>

                        <Label id="labelCountry" labelFor="selectCountry" text="{i18n>country}" class="sapUiSmallMargin" />
                        <Select id="selectCountry" selectedKey="{selectionScreenMenu>/CountryKey}"
                                                   forceSelection="false"
                                                   items="{selectionScreenMenu>/Countries}">
                            <items>
                                <core:Item key="{selectionScreenMenu>key}" text="{selectionScreenMenu>text}" />
                            </items>
                        </Select>

                        <Button id="btnFilter" 
                                text="{i18n>btnFilter}" 
                                icon="sap-icon://filter" 
                                press="onFilter" 
                                class="sapUiSmallMarginEnd"/>

                        <Button id="btnClearFilter" 
                                text="{i18n>btnClearFilter}" 
                                icon="sap-icon://clear-filter" 
                                press="onClearFilter" 
                                class="sapUiSmallMarginEnd"/>                                
                    </Panel>
                </content>
            </Page>
        </pages>
    </App>
    </Shell>
</mvc:View>